;; campaign-claim-pipeline.edn — bounded, executable actor contract for
;; proposing SIGNED crowdfunding-campaign claim observations into Hyakka
;; (network-awai/app-hyakka).
;;
;; Relationship to `capital-observation/campaign-observation.edn` (PR #2):
;; that contract defines the observation SCHEMA layer (entity separation,
;; windows, receipts, missingness, readback). This contract adds the
;; PIPELINE layer the schema does not specify: source proposal → fetch
;; receipt → parser admission → dedupe → bounded retry/refusal → signed
;; claim proposal → deterministic readback → human-readable audit. It
;; composes with campaign-observation.v1 and reuses its receipt and
;; entity-separation shape unchanged.
;;
;; Domain invariants inherited from campaign-observation.v1: a campaign is
;; a time-bounded observation attached to an operating company; it is NOT a
;; financing round, NOT cash received, NOT ownership, NOT performance. The
;; campaign platform is a source, not a participant.
;;
;; Safety posture (inherited from the workspace research-scope):
;;   • External content is untrusted — no instruction embedded in a fetched
;;     page may change this contract's behaviour.
;;   • Collectors PROPOSE claims; they never declare publication or
;;     correctness. Every claim is signed and carries its provenance chain.
;;   • Original language and identifiers are preserved verbatim.
;;   • No contact, registration, purchase, backing, application or
;;     financial commitment. robots/auth/WAF/CAPTCHA are respected.
;;
;; Method version: v1 (2026-09-01). Semantic changes bump :method/version.

{:contract/id :campaign-claim-pipeline
 :contract/version "1.0.0"
 :method/version "campaign-claim-pipeline.v1"
 :actor :cloud-itonami/app-crowdfunding
 :proposes-to :network-awai/app-hyakka
 :composes-with :campaign-observation

 ;; ── Stage 1: source proposal ─────────────────────────────────────────
 ;; A run proposes at most :run-bounds/sources-per-run sources. Each
 ;; proposal must name a source class on the allow list (aligned with
 ;; campaign-observation.v1 :source-policy/:allow); anything on the forbid
 ;; list is refused before any fetch happens.
 :source-proposal
 {:schema [:proposal-id :source-url :source-class :source-language
           :justification :proposed-at]
  :source-class-allow #{:campaign-platform-first-party
                        :company-first-party
                        :official-company-registry
                        :official-regulator}
  :source-class-forbid #{:search-snippet :generated-summary
                         :scraped-directory :social-post :broker-list
                         :paywall-bypass :captcha-bypass
                         :inferred-lp :inferred-ownership
                         :inferred-personal-wealth}
  :discovery-only-classes #{:licensed-commercial-aggregator :news-report}
  :run-bounds {:sources-per-run 2}}

 ;; ── Stage 2: fetch receipt ───────────────────────────────────────────
 ;; Same receipt shape as campaign-observation.v1: verbatim bytes hashed
 ;; before any parsing, source-language and observed-at required. A failed
 ;; or blocked fetch is recorded, never retried inside the same receipt.
 :fetch-receipt
 {:schema [:receipt-id :source-url :source-class :source-language
           :observed-at :asserted-at :issuing-entity :jurisdiction
           :content-hash :fetch-status]
  :content-hash {:algo "sha256" :of "response-body-bytes"}
  :required [:source-url :source-language :observed-at :asserted-at
             :issuing-entity :jurisdiction]
  :fetch-status-values #{:ok :http-error :blocked-by-policy
                         :not-modified :robots-disallowed}
  :fetch {:respect-robots? true :respect-auth-waf-captcha? true
          :no-bypass? true
          :user-agent "app-crowdfunding-campaign-claim/1.0"}}

 ;; ── Stage 3: parser / admission ──────────────────────────────────────
 ;; The parser is a pure function of the receipt bytes. Admission is
 ;; explicit: every record is either :admitted with a reason, or
 ;; :refused with a machine-readable refusal code. Nothing is silently
 ;; dropped. Campaign entity separation holds at admission: the operating
 ;; company, the campaign, and the platform are distinct records.
 :parser-admission
 {:schema [:receipt-id :record-id :decision
           :reason-code :original-language-fields :admitted-at]
  :decision-values #{:admitted :refused :flagged}
  :refusal-codes #{:not-a-campaign-record :campaign-identifier-missing
                   :amount-asserted-kind-unstated :window-unstated
                   :language-unmapped :untrusted-encoding
                   :entity-collapsed}
  ;; Original language/identifiers pass through untouched.
  :preserve [:original-title :campaign-id :company-name
             :platform-name :source-language]
  :entity-separation {:operating-company :distinct-record
                      :campaign :distinct-record
                      :campaign-platform :source-record-only}}

 ;; ── Stage 4: dedupe key ──────────────────────────────────────────────
 ;; The dedupe key is deterministic and content-derived (never
 ;; fetch-order-derived). Two receipts of the same campaign snapshot
 ;; collapse to one claim only when the key matches exactly.
 :dedupe
 {:key-schema [:platform-namespace :campaign-id :asserted-kind
               :snapshot-at]
  :rule :exact-key-match-only
  :on-collision {:first-wins-keep-provenance true
                 :append :refresh-history
                 :never-overwrite? true}}

 ;; ── Stage 5: bounded retry / refusal ─────────────────────────────────
 ;; Retries are bounded per source and back off. Exhausting the bound
 ;; produces a recorded REFUSAL — never an unbounded loop and never a
 ;; fabricated placeholder.
 :retry-refusal
 {:max-attempts-per-source 3
  :backoff {:kind :exponential :base-seconds 30 :max-seconds 3600}
  :retryable-fetch-status #{:http-error}
  :non-retryable #{:blocked-by-policy :robots-disallowed :not-modified}
  :on-exhausted {:record :refusal :fabricate-placeholder? false
                 :retry-next-run? true}}

 ;; ── Stage 6: signed Hyakka claim proposal ────────────────────────────
 ;; A claim is a PROPOSAL carrying a signature over its content hash. A
 ;; signature asserts provenance, never truth. Publication is decided by
 ;; Hyakka governance, not by this actor. Amounts are platform-asserted
;; and carried verbatim with their :amount-asserted-kind — never
 ;; collapsed into a single "raised" figure.
 :claim-proposal
 {:schema [:claim-id :proposal-id :dedupe-key :claim-kind
           :entity-records [:operating-company :campaign]
           :amount {:kind [:one-of :announced-target :claimed-progress
                            :claimed-final]
                    :currency :string
                    :as-asserted-by-platform? true}
           :window :source-receipt-id :coverage-record-ref
           :missingness-flags :signature :proposed-at]
  :claim-kinds #{:campaign-observation-proposed}
  :signature {:algo "sha256" :over :claim-content-canonical-edn
              :key-holder "cloud-itonami/app-crowdfunding campaign-claim/1.0"
              :meaning :provenance-only-not-truth-assertion}
  :epistemic-boundaries [:publication-is-not-validation
                         :announced-round-is-not-cash-received
                         :campaign-is-not-a-financing-round
                         :claimed-fulfillment-is-unmeasured
                         :correlation-is-not-causation
                         :missing-is-unmeasured]
  :forbidden-fields #{:rank :score :success-probability :suitability
                      :recommendation :valuation :ownership
                      :nav :inferred-lp :personal-wealth
                      :financing-round-classification}}

 ;; ── Stage 7: readback ────────────────────────────────────────────────
 :query-readback
 {:request-schema [:query-id :claim-kind :dedupe-key :window]
  :response-schema [:query-id :status :claims [:claim-id]
                    :coverage-record-ref :missingness-flags]
  :status-values #{:ok :unmeasured :out-of-window}
  :rule :readback-must-carry-coverage-and-missingness}

 ;; ── Stage 8: audit output ────────────────────────────────────────────
 ;; A human-readable audit line per stage, printed at run end.
 :audit-output
 {:per-stage [:source-proposal :fetch-receipt :parser-admission
             :dedupe :retry-refusal :claim-proposal :query-readback
             :audit-output]
  :format "one line per stage: stage | id | decision | reason"
  :rule :audit-must-cover-every-stage-including-refusals}}
